# Dependências do Node (nunca envie para o Git)
node_modules/
dist/
build/

# Arquivos de log e cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.tsbuildinfo

# Variáveis de ambiente e dados sensíveis (senhas do Firebird, chaves, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Arquivos gerados pelo Sistema Operacional
.DS_Store
Thumbs.db

# Se o seu banco de dados Firebird (.fdb) estiver dentro da pasta do projeto,
# ignore-o para não travar o Git com arquivos gigantes e pesados:
*.fdb
